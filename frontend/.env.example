# ---------------------------------------------------------------------------
# Events Emporio — environment variables
# Copy to .env.local. Only NEXT_PUBLIC_* values are ever exposed to the browser.
# ---------------------------------------------------------------------------

# Canonical site origin (metadata, sitemap, structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Backend phase (not used by the frontend demo yet) --------------------
# MONGODB_URI=
# SESSION_SECRET=                 # 32+ random bytes, server only
# RAZORPAY_KEY_ID=                # server only; the public key is sent per checkout session
# RAZORPAY_KEY_SECRET=            # server only — never prefix with NEXT_PUBLIC_
# RAZORPAY_WEBHOOK_SECRET=        # server only, verifies webhook signatures
# CLOUDINARY_URL=                 # or AWS S3 credentials for media uploads
# RESEND_API_KEY=                 # transactional email
# UPSTASH_REDIS_REST_URL=         # optional: rate limiting
# UPSTASH_REDIS_REST_TOKEN=
