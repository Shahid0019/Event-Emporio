# ---------------------------------------------------------------------------
# Events Emporio — environment variables
# Copy to .env.local. Only NEXT_PUBLIC_* values are ever exposed to the browser.
# ---------------------------------------------------------------------------

# Canonical site origin (metadata, sitemap, structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin sign-in for /admin (one shared login for the shop team).
# Use your own values in .env.local; the secret must be 32+ random characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Admin image uploads → Amazon S3 (server only). The browser uploads straight to
# S3 with a 2-minute presigned POST; the bucket needs CORS allowing POST from
# your site's origin, and public read for the uploads (or a CDN in front).
# Without these, `next dev` saves uploads to public/uploads instead.
# AWS_REGION=ap-south-1
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=              # IAM user limited to s3:PutObject on the bucket
# AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=             # optional: CloudFront/CDN URL serving the bucket

# Database (server only) — MongoDB Atlas connection string. For local development
# run `npm run db:local` and use mongodb://127.0.0.1:27017. On first connection the
# starting catalogue, kits and site content are copied in automatically.
MONGODB_URI=mongodb+srv://shahid:shahid@cluster0.1ynj5.mongodb.net/
MONGODB_DB=events_emporio

# Razorpay (server only). Test keys while testing, live keys to go live.
# Webhook (Razorpay Dashboard → Settings → Webhooks): URL https://<your-site>/api/razorpay/webhook,
# events "payment.captured", "order.paid", "payment.failed" and "refund.processed", with this secret.
# Keep payment auto-capture on (Settings → Payment capture) so payments are captured automatically.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Customer account sessions (32+ random characters).
SESSION_SECRET=

# Optional: transactional email (password resets, order confirmations) via Resend.
# RESEND_API_KEY=
# EMAIL_FROM="Events Emporio <orders@yourdomain.com>"
